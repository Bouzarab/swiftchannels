{
  "name": "swiftchannels",
  "private": true,
  "description": "Static site for swiftchannels.com — build scripts only, nothing is bundled into the site.",
  "scripts": {
    "build": "node build.js",
    "blog:write": "node scripts/write-blog-posts.js",
    "blog:notes": "node scripts/write-blog-notes.js",
    "blog:posters": "node scripts/fetch-blog-posters.js",
    "blog:preview": "BLOG_PREVIEW_ALL=1 node build.js",
    "og": "node build-og.js",
    "indexnow": "node indexnow.js"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.0.0",
    "@fontsource/sora": "^5.0.0",
    "playwright": "^1.40.0"
  }
}
